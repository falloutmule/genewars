# Evidence receipts have byte-level hashes; preserve their recorded line endings.
*.json -text whitespace=cr-at-eol
# The dated source receipt includes a terminal blank line; keep its exact bytes.
research/tooling-sources.json whitespace=cr-at-eol,-blank-at-eof
# Console diagnostics are preserved verbatim, including table padding.
*.txt -text -whitespace
# Native/source validation receipts also hash exact implementation bytes.
*.rs -text whitespace=cr-at-eol
*.py -text whitespace=cr-at-eol
*.java -text whitespace=cr-at-eol
*.toml -text whitespace=cr-at-eol
*.lock -text whitespace=cr-at-eol
*.tsv -text whitespace=cr-at-eol
